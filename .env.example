# 复制本文件为 .env 并按本机环境修改

# 数据库配置
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/ai_nutritionist?charset=utf8mb4

# JWT 密钥（生产环境请更换为随机长字符串）
SECRET_KEY=ainutritionist-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM（阿里云百炼 OpenAI 兼容接口）
# API Key 默认读取系统环境变量 DASHSCOPE_API_KEY，也可在此处直接填写
# LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_CHAT_MODEL=qwen-flash
VISION_MODEL=qwen-vl-max
EMBEDDING_MODEL=text-embedding-v3

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
